# Backend: copy to .env; load with your process manager (never commit secrets).
DATABASE_URL=postgresql+psycopg://orbit:change-me@localhost:5432/orbit
DATA_DIR=/workspace/REA/backend/data
AUTO_CREATE_SCHEMA=false
CORS_ORIGINS=http://localhost:5173
# Operator approves sellers and securely provisions a different random key per seller.
MERCHANT_KEYS_JSON={"demo":"replace-with-long-random-key"}
LABOR_RATES_JSON={"USD":{"living":8,"bedroom":7,"office":6}}
CONSULTATION_URL=
LEAD_WEBHOOK_URL=
LEAD_WEBHOOK_TOKEN=

# Optional image providers: configure at least one securely; never put in VITE_ variables.
ROOM_OPENAI_API_KEY=
ROOM_OPENAI_MODEL=gpt-image-1.5
ROOM_GEMINI_API_KEY=
ROOM_GEMINI_MODEL=gemini-2.5-flash-image
# Operator approval/inbox access; use a unique high-entropy secret, never VITE_.
ROOM_OPERATOR_KEY=

# Project marketplace / browser sessions. Deploy frontend and API on the same origin.
APP_URL=http://localhost:5173
COOKIE_SECURE=false
ALLOW_GUEST_PREVIEWS=false
ENABLE_AI_GENERATION=false
# Keep disabled until paid AI image delivery is implemented and tested.
ENABLE_PROJECT_SALES=false
# Actual bank/provider instructions, including exchange-rate rules if settling USD in PKR.
PAYMENT_INSTRUCTIONS=
# Optional password recovery; run app.mail_worker regularly to send queued recovery mail.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Docker Compose only: URL-safe random password, e.g. secrets.token_hex(24).
POSTGRES_PASSWORD=
WEB_PORT=8080

# Hardened staging: no legacy operator keys. Create named admins with app.create_admin.
ALLOW_LEGACY_OPERATOR_KEY=false
REQUIRE_VERIFIED_EMAIL=true
APP_ENV=staging
STAGING_DOMAIN=
STAGING_USER=
STAGING_PASSWORD_HASH=
# Optional approved Stripe merchant account: staging accepts test keys only.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional agreed seller commission percentage (0–40). Blank disables commission tracking.
# Tracking does not collect money; settlement requires a marketplace payment provider.
MARKETPLACE_COMMISSION_PERCENT=

# Photo-based workflow (synthetic demo products are hidden by default).
ROOM_PRIMARY_PROVIDER=gemini
ROOM_MATTING_MODEL=u2netp
ALLOW_DEMO_CATALOG=false
ALLOW_LEGACY_PHOTOS=false
# Optional visual grounding after each AI render; adds a separate provider request.
ENABLE_AI_HOTSPOTS=true
ROOM_GEMINI_VISION_MODEL=gemini-2.5-flash
ROOM_OPENAI_VISION_MODEL=gpt-4.1-mini
# Beta safety cap: paid AI attempts per customer in a rolling 24-hour window.
# Includes failed requests; does not represent a paid subscription entitlement.
ROOM_AI_DAILY_LIMIT=3

# Measured product-protected beta. Keep disabled until live quality evaluation.
ENABLE_PROTECTED_PLACEMENT=false
# HTTPS endpoint implementing docs/PROTECTED_PLACEMENT.md detection+mask contract.
ROOM_PERCEPTION_URL=
ROOM_PERCEPTION_API_KEY=
# A fresh protected workflow reserves three daily attempt slots atomically;
# a measured replacement/reused cleanup reserves one. These are beta safety
# reservations (including failed/unused stages), not paid package entitlements.

# Finalization booking: operations recipient and flat service fee per currency.
# Example fee format: {"USD":25,"PKR":5000}; configure your actual charges.
FINALIZATION_EMAIL=
FINALIZATION_SERVICE_FEES_JSON=
